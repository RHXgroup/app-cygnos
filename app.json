{
  "expo": {
    "name": "Cygnos",
    "slug": "gruporhx",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cygnosnutri.app"
    },
    "android": {
      "package": "com.cygnosnutri.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cygnos acessa suas fotos para você mandar a imagem do seu perfil, a foto do prato ou a ficha de treino da academia.",
          "cameraPermission": "O Cygnos usa a câmera para você fotografar o prato, a ficha de treino ou a imagem do seu perfil."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "O Cygnos usa o microfone para você falar o que comeu em vez de digitar, e para gravar um áudio para a sua nutricionista."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#15803D"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Cygnos usa o microfone para você falar o que comeu em vez de digitar, e para gravar um áudio para a sua nutricionista.",
          "speechRecognitionPermission": "O Cygnos transforma a sua voz em texto no próprio celular, enquanto você fala. O áudio não sai do aparelho.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/cygnos-icon.png",
          "backgroundColor": "#F4EFE4",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "18848ee4-c435-4c84-952c-7be6a0bc79d1"
      }
    },
    "owner": "gruporhx"
  }
}
